# ---------------------------------------------------------------------------
# InsightCart - example environment configuration
#
# Copy this file to `.env` in the repository root and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the FastAPI backend and the ETL loaders.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: keep this in sync with a database that contains the `retail` schema.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/insightcart

# Comma-separated list of browser origins allowed to call the API.
# Use '*' only for local throwaway experiments - it is not safe in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log level for the backend: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
